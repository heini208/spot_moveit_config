<robot name="spot">
  <virtual_joint name="odom_joint" type="floating" parent_frame="odom" child_link="body" />
  <group name="arm">
    <chain base_link="body" tip_link="hand" />
  </group>
  <group name="gripper">
    <joint name="arm_f1x" />
  </group>
  <end_effector name="gripper" parent_link="arm_link_wr1" group="gripper" parent_group="arm" />
  <passive_joint name="front_left_hip_x" />
  <passive_joint name="front_left_hip_y" />
  <passive_joint name="front_left_knee" />
  <passive_joint name="front_right_hip_x" />
  <passive_joint name="front_right_hip_y" />
  <passive_joint name="front_right_knee" />
  <passive_joint name="rear_left_hip_x" />
  <passive_joint name="rear_left_hip_y" />
  <passive_joint name="rear_left_knee" />
  <passive_joint name="rear_right_hip_x" />
  <passive_joint name="rear_right_hip_y" />
  <passive_joint name="rear_right_knee" />
  <group_state name="open" group="gripper">
    <joint name="arm_f1x" value="-1.57" />
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="arm_f1x" value="0.0" />
  </group_state>
  <disable_collisions link1="body" link2="base_link" reason="Adjacent" />
  <disable_collisions link1="body" link2="front_rail" reason="Adjacent" />
  <disable_collisions link1="body" link2="rear_rail" reason="Adjacent" />
  <disable_collisions link1="body" link2="front_left_hip" reason="Adjacent" />
  <disable_collisions link1="front_left_hip" link2="front_left_upper_leg" reason="Adjacent" />
  <disable_collisions link1="front_left_upper_leg" link2="front_left_lower_leg" reason="Adjacent" />
  <disable_collisions link1="body" link2="front_right_hip" reason="Adjacent" />
  <disable_collisions link1="front_right_hip" link2="front_right_upper_leg" reason="Adjacent" />
  <disable_collisions link1="front_right_upper_leg" link2="front_right_lower_leg" reason="Adjacent" />
  <disable_collisions link1="body" link2="rear_left_hip" reason="Adjacent" />
  <disable_collisions link1="rear_left_hip" link2="rear_left_upper_leg" reason="Adjacent" />
  <disable_collisions link1="rear_left_upper_leg" link2="rear_left_lower_leg" reason="Adjacent" />
  <disable_collisions link1="body" link2="rear_right_hip" reason="Adjacent" />
  <disable_collisions link1="rear_right_hip" link2="rear_right_upper_leg" reason="Adjacent" />
  <disable_collisions link1="rear_right_upper_leg" link2="rear_right_lower_leg" reason="Adjacent" />
  <disable_collisions link1="body" link2="arm_link_sh0" reason="Adjacent" />
  <disable_collisions link1="arm_link_sh0" link2="arm_link_sh1" reason="Adjacent" />
  <!-- hr0 is fixed to collisionless sh1 at the shoulder joint origin. -->
  <disable_collisions link1="arm_link_sh0" link2="arm_link_hr0" reason="Adjacent" />
  <disable_collisions link1="arm_link_sh1" link2="arm_link_hr0" reason="Adjacent" />
  <disable_collisions link1="arm_link_hr0" link2="arm_link_el0" reason="Adjacent" />
  <disable_collisions link1="arm_link_el0" link2="arm_link_el1" reason="Adjacent" />
  <disable_collisions link1="arm_link_el1" link2="arm_link_wr0" reason="Adjacent" />
  <disable_collisions link1="arm_link_wr0" link2="arm_link_wr1" reason="Adjacent" />
  <disable_collisions link1="arm_link_wr1" link2="arm_link_fngr" reason="Adjacent" />
</robot>
